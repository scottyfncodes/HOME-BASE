# ---------------------------------------------------------------------------
# Home Base environment variables. Copy to .env.local for development.
# Every value here is a placeholder. Never commit real secrets.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon, Supabase, RDS, local Postgres...).
# Leave UNSET in development to run on the embedded PGlite database stored in
# ./.data/pglite (no credentials required). Production REQUIRES this value.
DATABASE_URL=

# Secret used by Better Auth to sign session cookies. Generate with:
#   openssl rand -base64 32
# Rotating it signs every user out.
BETTER_AUTH_SECRET=replace-with-32-plus-random-bytes

# Public origin of the deployed app (no trailing slash). Used for auth
# callbacks and trusted-origin checks. Example: https://home-base-haveanapp.vercel.app
APP_URL=http://localhost:3000

# 32-byte key, base64 encoded, that wraps the per-file data keys for Vault
# documents (encryption at rest, server-side). Generate with:
#   openssl rand -base64 32
# Losing this key makes every Vault file unrecoverable. Store it in a secret
# manager, not in source control.
VAULT_MASTER_KEY=

# Optional. Maximum upload size in megabytes (default 10).
MAX_UPLOAD_MB=10

# Email via Resend (https://resend.com). Needed for password reset, household
# invite emails and the weekly reminder email. Without these, development
# prints each email to the server console and production sends nothing.
# EMAIL_FROM must use a domain verified in Resend, e.g. "Home Base <home@example.com>".
RESEND_API_KEY=
EMAIL_FROM=

# Shared secret for the scheduled reminder job (/api/cron/digest). Vercel
# sends it automatically as a bearer token when set. Generate with:
#   openssl rand -base64 32
CRON_SECRET=
